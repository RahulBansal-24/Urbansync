# ==========================================
# URBANSYNC ENVIRONMENT CONFIGURATION
# ==========================================

# DATABASE (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urbansync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urbansync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# TOMTOM SERVICES (Map Display, Traffic, Routing)
# Get key at https://developer.tomtom.com/
TOMTOM_API_KEY=placeholder_tomtom_api_key_here
NEXT_PUBLIC_TOMTOM_API_KEY=placeholder_tomtom_api_key_here

# WEATHERAPI.COM
# Get key at https://www.weatherapi.com/
WEATHERAPI_KEY=placeholder_weatherapi_key_here
OPEN_METEO_ENABLED=true

# EVENTBRITE PUBLIC INGESTION (No API key required)
# Ingests live public events from Eventbrite listing pages

# OPENSTREETMAP OVERPASS API (No API key required)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# DELHI OPEN TRANSIT DATA (Delhi OTD)
# Get key at https://otd.delhi.gov.in/
DELHI_OTD_REALTIME_KEY=placeholder_delhi_otd_key_here

# GROQ LLM API (AI Explanations & Assistant)
# Get key at https://console.groq.com/
GROQ_API_KEY=placeholder_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# APPLICATION URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
PORT=8000
